{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ytb-notebook",
  "version": "0.1.0",
  "identifier": "com.angrysquirrel.ytb-notebook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Youtube Notebook",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.svg"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ytb-notebook"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "ytb-notebook"
          ],
          "appLink": false
        }
      ]
    }
  }
}